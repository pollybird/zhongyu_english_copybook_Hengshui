{
  "name": "zhy-en-copybook-electron",
  "version": "2.0.7",
  "description": "钟毓英语衡水体字帖生成器",
  "main": "out/main/index.js",
  "author": "泰州姜堰钟毓信息技术有限公司",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node --experimental-default-type=module --test tests/zyecb-format.test.js tests/engine.test.js tests/update-feed.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "build:all": "npm run build && electron-builder --linux AppImage deb rpm --x64 --arm64 --publish never && electron-builder --win nsis --x64 --publish never && electron-builder --mac zip --x64 --arm64 --publish never",
    "publish:gitcode": "node scripts/publish-gitcode.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^41.7.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "vite": "^6.4.5"
  },
  "build": {
    "appId": "cn.tzzhy.englishcopybook",
    "productName": "钟毓英语衡水体字帖生成器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "resources/app_icon.png"
    ],
    "extraResources": [
      {
        "from": "resources/copyright.txt",
        "to": "copyright.txt"
      },
      {
        "from": "resources/ocr-data",
        "to": "ocr-data"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/app_icon.ico",
      "artifactName": "${name}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/app_icon.icns",
      "category": "public.app-category.education",
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "resources/icons",
      "category": "Education",
      "maintainer": "泰州姜堰钟毓信息技术有限公司 <44961355+pollybird@users.noreply.github.com>",
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "zyecb",
        "name": "钟毓英语字帖工程文件",
        "description": "钟毓英语衡水体字帖工程文件",
        "icon": "resources/app_icon.ico"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "pollybird",
        "repo": "zhongyu_english_copybook_Hengshui"
      }
    ]
  },
  "dependencies": {
    "tesseract.js": "^7.0.0",
    "electron-updater": "^6.8.9"
  }
}
